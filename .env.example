# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o GitHub.

# Chave da API da Groq (https://console.groq.com > API Keys)
GROQ_API_KEY=cole_sua_chave_aqui

# Opcional: troca o modelo sem mexer no código (padrão: openai/gpt-oss-120b)
# GROQ_MODEL=

# Opcional: limite de perguntas por minuto (padrões: 4 por usuário, 5 no total)
# LIMITE_POR_IP=4
# LIMITE_GLOBAL=5
